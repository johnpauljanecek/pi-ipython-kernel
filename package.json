{
  "name": "@johnjanecek/ipyforge-kernel",
  "version": "0.1.0",
  "keywords": [
    "pi-package"
  ],
  "description": "Pi extension for controlling an IPython kernel via HTTP",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "test:bridge": "uv run pytest tests/test_bridge.py -v",
    "typecheck": "tsc --noEmit"
  }
}
